# Copy to .env.production.local (for npm run deploy) or .env.local (npm run dev against the real project) and fill in
# from Firebase console → Project settings → Your apps → Web app.
# Without these the app runs on demo data only (P3 behaviour). See docs/SETUP_AND_DEPLOY.md.
VITE_FIREBASE_API_KEY=
# Must be the domain that serves the app (e.g. your-project.web.app), so Google sign-in works on iPhone.
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
